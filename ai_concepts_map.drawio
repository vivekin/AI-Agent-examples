        </mxCell>
        <mxCell id="p2_rl" value="&lt;b&gt;Reinforcement learning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Learn from rewards for good outputs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="p2_g1">
          <mxGeometry x="15" y="172" width="210" height="56" as="geometry" />
        </mxCell>
